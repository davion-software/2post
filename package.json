{
  "name": "2post",
  "version": "0.1.0",
  "private": true,
  "description": "Infraestructura de publicación social mediante REST y MCP",
  "type": "commonjs",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": "10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "nest build",
    "start:api": "node --env-file-if-exists=.env dist/entrypoints/api.js",
    "start:worker": "node --env-file-if-exists=.env dist/entrypoints/worker.js",
    "dev:build": "nest build --watch",
    "dev:api": "node --env-file-if-exists=.env --watch dist/entrypoints/api.js",
    "dev:worker": "node --env-file-if-exists=.env --watch dist/entrypoints/worker.js",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build && node --env-file-if-exists=.env dist/entrypoints/migrate.js",
    "lint": "pnpm build && vp lint --deny-warnings .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "pnpm build && vp test --project unit",
    "test:integration": "pnpm build && vp test --project integration",
    "check": "pnpm build && vp check --deny-warnings && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p scripts/tsconfig.json && pnpm architecture:check && vp test --project unit",
    "dev:doctor": "node scripts/doctor.mjs",
    "dev:setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "architecture:check": "fallow architecture && fallow --config .fallow-modules.json architecture",
    "architecture:report": "fallow",
    "db:check": "node scripts/check-migrations.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "verify": "node scripts/verify.mjs",
    "tooling:check": "node scripts/check-tooling.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "fallow": "3.35.0",
    "typescript": "5.9.3",
    "vite-plus": "catalog:"
  }
}
