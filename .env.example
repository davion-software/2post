NODE_ENV=development
HOST=127.0.0.1
PORT=3000
POSTGRES_PORT=5432
COMPOSE_PROJECT_NAME=two-post
LOG_LEVEL=info
# Credenciales exclusivas de desarrollo local.
DATABASE_URL=postgresql://two_post:two_post_local@127.0.0.1:5432/two_post
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=2000
WORKER_HEALTH_INTERVAL_MS=30000
# Las pruebas de integración requieren una base separada.
TEST_DATABASE_URL=postgresql://two_post:two_post_local@127.0.0.1:5432/two_post_test
